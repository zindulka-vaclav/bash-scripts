#!/bin/bash
# script slouzi pro synchronizaci databaze z ostreho serveru na zalozni - neprenasi se historie ani trendy
# jsou implementovany ochrany, aby se neprepsala databaze pri provozu na zaloznim serveru
# na zaloznim serveru musi byt pristupny uzivatel postgres heslem primo z roota, aby bylo mozne provest
# drop a vytvoreni databaze
# musi se tez zajistit, ze nenastane dlouhodoby soubeh sluzeb zabbix serveru, protoze se castecne
# vyuziva pasivnich proxy a vyziraly by si data navzajem
# zalozni server musi mit pristup na ostry pres ssh klic

# zajisti, ze pri selhani jednoho prikazu v pipe selze cela pipe
set -o pipefail

#LIST
#_PROMENNE
#_LOGOVANI
#_KONFIGURACE
#_ZABBIX_SYNC_CRON
# _kontrola_DNS
# _zaloha_ostre_databaze
# _stazeni_zalohy_ostre_databaze
# _drop_databaze_na_zaloznim_serveru
# _obnova_zalohy_na_zaloznim_serveru

VERSION_MAJOR=1
VERSION_MINOR=0
VERSION_PATCH=0
VERSION="$VERSION_MAJOR.$VERSION_MINOR.$VERSION_PATCH"


#_PROMENNE
scriptName="zabbix-sync"

# uzivatel pro provadeni a stahovani zalohy z ostreho serveru - musi mit definovat pristup do databaze v
# ~/.pgpass
remoteUser="zabbix-sync"

# slozka, kam se na ostrem serveru provede zaloha
remoteBackupDir="zabbix-sync"

# slozka, kam se na lokalnim serveru stahne remote zaloha
localBackupDir="/var/backup/$remoteBackupDir/"

#cesta ke scriptu
scriptDir="/usr/local/bash-scripts"
verbose=0
deBug=0

# vychozi hodnota, kterou lze pretizit v configu
procNum=4

# pri predani parametru -x provede zapnuti debug logu
if [ "$1" = "-x" ]
then
	set -x
fi

# vypsani verze
if [ "$1" = "-V" -o "$1" = "--version" ]
then
	echo "$VERSION"
	exit 0
fi

# zapne verbose vystup
if [ "$1" = "-v" -o "$1" = "--verbose" ]
then
	verbose=1
fi


#_LOGOVANI
#nacteni definice funkci Log,LogError,RvLog,MailSend z knihovny
. $scriptDir/funkce	
Log "script ($scriptName) - zacatek"
echo "$$" > "$startFile"
Log "($startFile) set to ($$)"


#_KONFIGURACE
#funkce pro zapis souboru pro mysqldump
write_pgpassFile()
{
	{
	echo "# hostname:port:database:username:password"
	echo "localhost:5432:zabbix:zabbix:ZABBIX_PASSWORD"
	echo "localhost:5432:zabbix:zabbix-test:ZABBIX_PASSWORD"
	} >> "$pgpassFile"
	chmod 600 "$pgpassFile"
}


#zapise konfiguracni soubor, ze ktereho bude nasledne nacitat hodnoty
write()
{
	if [ -f "$configFile" ]
	then
	cp "$configFile" "${configFile}.back"
	RvLog "provedena zaloha konfigurace do (${configFile}.back)"
	fi	
	{
	echo "#vypne/zapne (1/0) provadeni scriptu"
	echo "disabled=1"
	echo ""
	echo "# IP adresa ostreho serveru - odkud se taha zaloha"
	echo "remoteIP=37.221.240.48"
	echo ""
	echo "# DNS zaznam, ktery slouzi pro preklopeni monitoringu - co nejkratsi TTL, idealne 300 = 5m"
	echo "dnsName=nmszabbix.tlapnet.cz"
	echo ""
	echo "# nazev databaze na ostrem serveru, ktera se bude zalohovat - idealne zachovavat zabbix"
	echo "# pristup musi byt definovany v ~/.pgpass"
	echo "remoteDbName=zabbix"
	echo ""
	echo "# uzivatel pro pristup k databazi na ostrem serveru - idealne zachovavat zabbix"
	echo "# pristup musi byt definovany v ~/.pgpass"
	echo "remoteDbUser=zabbix"
	echo ""
	echo "# nazev databaze na zaloznim serveru, kam se obnovi zaloha z ostreho - zabbix | zabbix-test"
	echo "# pristup musi byt definovany v ~/.pgpass"
	echo "# pro testovani lze posilat do testovaci databaze - pozor, na jine hodnoty nez zabbix, nebo zabbix-test"
	echo "localDbName=zabbix-test"
	echo ""
	echo "# uzivatel pro pristup k databazi na zaloznim serveru - idealne zachovavat zabbix"
	echo "# pristup musi byt definovany v ~/.pgpass"
	echo "localDbUser=zabbix"
	echo ""
	echo "#urcuje pocet soubeznych procesu pro zalohovani a obnoveni databaze"
	echo "#pro kazdy jeden proces to znamena jeden pg_dump a jeden postgresql worker, takze opatrne"
	echo "procNum=4"
	} > "$configFile"
	LogError "zapsan konfiguracni soubor pro server ($HOSTNAME)"
}


# soubor s heslem k postgresql databazi zabbixu
pgpassFile="$HOME/.pgpass"

#kontrola existence pgpassFile, pripadne vytvoreni z existujiciho configu
#v pripade prazdneho hesla zaloguje error
if [ ! -f "$pgpassFile" ]
then
	write_pgpassFile
	LogError "Zapsan novy soubor [$pgpassFile] nutno doplnit heslo pro uzivatele zabbix"
	exit 1
fi

#_ZABBIX_SYNC_CRON
#pokud neni zaznam pro postgresql-backup
if [ ! -e /etc/cron.d/zabbix-backup ]
then
	#vytvori zaznam, ktery pravidelne spousti dany script v nastaveny cas a kompletni vystup se uklada do /var/log
	{ 
		echo "#denni spousteni zabbix-backup"
		echo "0 2 * * * root $sbinDir/zabbix-backup &>$outputFile"
	} > /etc/cron.d/zabbix-backup
	RvLog "zapsano spousteni zabbix-backup scriptu do cronu"
fi

#nacteni $configFile, pripadne zapsani defaultniho
if [ -f "$configFile" ]
then
	. "$configFile"
	Log "nacten konfiguracni soubor ($configFile)"
else
	write
	. "$configFile"
	LogError "Byl zapsan konfiguracni soubor, nutno upravit konfiguraci"
	exit 1
fi

#nastavenim disabled na 1 se vypne spousteni scriptu, uprav $configFile, mail se neposila
if [ "$disabled" -eq 1 ]
then
	Log "script ($scriptName) byl disablovan v konfiguracnim souboru ($configFile)"
	exit 1
fi


#kontrola, zda mysqlPassword neobsahuje EMPTY
if [ $(grep -c "ZABBIX_PASSWORD" "$pgpassFile") -ne 0 ]
then
	LogError "POZOR, neni nastaveno heslo pro zabbix-backup v [$pgpassFile]"
	MailSend
	exit 1
fi

# _kontrola_DNS
Log "kontrola DNS zaznamu"

if [ $(ping -c1 "$dnsName" | grep -c "$remoteIP") -eq 0 ]
then
	LogError "Problem pri overeni DNS zaznamu [$dnsName] nemiri na pozadovanou IP [$remoteIP]"
	LogError "Script nebude pokracovat, aby nedoslo k prepsani produkcni databaze"
	exit 1
fi
# _kontrola_DNS

Log "zacatek zalohy databaze na ostrem serveru"

# _zaloha_ostre_databaze
if ! ssh "$remoteUser"@"$remoteIP" << EOF
rm -r $remoteBackupDir
pg_dump -U$remoteDbUser -w --dbname=$remoteDbName --create --clean \
	--format=directory --file=$remoteBackupDir --jobs=$procNum --schema=public
EOF
then
	LogError "Problem pri vytvareni zalohy databaze na ostrem serveru"
	exit 2
else
	Log "Uspesne vytvorena zaloha ostre databaze"
fi
# _zaloha_ostre_databaze

# _stazeni_zalohy_ostre_databaze
Log "stazeni zalohy na zalozni server"
if ! (rm -r "$localBackupDir"; scp -r "$remoteUser"@"$remoteIP":"$remoteBackupDir" "$localBackupDir")
then
	LogError "Problem pri stahovani zalohy z ostreho serveru [$remoteIP]"
	exit 3
else
	Log "Uspesne stazena zaloha z remote serveru [$remoteIP]"
fi
# _stazeni_zalohy_ostre_databaze

# _drop_databaze_na_zaloznim_serveru
Log "drop databaze na zaloznim serveru"
if ! psql -Upostgres -v ON_ERROR_STOP=1 << EOF
DROP DATABASE IF EXISTS $localDbName;
CREATE DATABASE $localDbName OWNER $localDbUser;
\c $localDbName
ALTER SCHEMA pulbic OWNER TO $localDbUser;
CREATE SCHEMA trends AUTHORIZATION $localDbUser;
CREATE SCHEMA history AUTHORIZATION $localDbUser;
EOF
then
	LogError "Problem pri dropu a znovu vytvoreni databaze $localDbName"
	exit 4
else
	Log "Uspesne dropnuta a znovu vytvorena databaze $localDbName"
fi
# _drop_databaze_na_zaloznim_serveru

# _obnova_zalohy_na_zaloznim_serveru
Log "obnova zalohy na zaloznim serveru"
if ! (cd "$localBackupDir" &&\
			pg_restore -U "$localDbUser" -w --dbname="$localDbName" \
				--if-exists --clean --schema=public --jobs="$procNum" . &&\
			psql -U "$localDbUser" -c "VACUUM ANALYZE;")
then
	LogError "Problem pri obnove databaze na zaloznim serveru"
	exit 5
else
	Log "Uspesne obnovena databaze na zaloznim serveru"
fi
# _obnova_zalohy_na_zaloznim_serveru

exit 0
