#!/bin/bash
#postgresql-backup-one
#provadi postgresql dumpy zvolene databaze - nevyzaduje pristup pod uzivatelem postgres

# set pipes to fail after first error, preserving last return value of failed process
set -eo pipefail

# set all parameters passed during execution of the script as single parameters
set -- "$@"

VERSION_MAJOR=1
VERSION_MINOR=0
VERSION_PATCH=5
VERSION="$VERSION_MAJOR.$VERSION_MINOR.$VERSION_PATCH"

# Declare_variables
# Load_functions
# Define_functions
# _Usage
# _write_config
# Process_parameters
# write_cron_file
# load_config_file
# process_variables
# dump_database
# dump_all_roles

# Declare_variables
scriptName="postgresql-backup-one"
instanceName=""
backupDir="/var/backup/postgresql"

# how many backup days to keep
backupLimit=14

# date / date time for backup structure
todayDate="$(date +%F)"
todayTime="$(date +%H-%M)"

# path to config file - multiple instances have multiple config files
configFile=""

scriptConfigVersion=1.2

# variable to pass postgres variables if set in config file
postgresqlParams_pg_dump=""
postgresqlParams_pg_dumpall=""

scriptDir="/usr/local/bash-scripts"

DEBUG_OUTPUT="false"
verbose=0
# Declare_variables

# Load_functions
#nacteni definice funkci Log,LogError,RvLog,StopProcessing z knihovny
source $scriptDir/funkce
# Load_functions

# Define_functions
# _Usage
# print usage of script
Usage() {
  echo -e "Script for creating PostgreSQL dump of one database.
Allows to run in multiple instances with different names using -i parameter
to support backups of dockerized database.

Allows different setups of accessing the database.
  - using sudo -u postgres pg_dump
	- using docker exec DOCKER_CONTAINER pg_dump
  - pg_dump using \$HOME/.pgpass file
	- pg_dump using password set in config file

To be able to access postgresql database using pgpass
create /root/.pgpass inside postgres container
Set its privileges to 600 and its content to:
# hostname:port:database:username:password
*:POSTGRES_PORT:*:POSTGRES_USERNAME:POSTGRES_PASSWORD

In case of Docker image create .pgpass file in \$HOME of user running psql and pg_dump command
postgres, root.

Usage:
  $SCRIPT_NAME  [OPTIONS] [PARAMETERS]

Supported parameters:
  -h | --help       Print usage informations
  -V | --version    Print version of the script
  -i INSTANCE_NAME  Set name to run multiple instances - eshop_cz | eshop_sk etc
  --dump-roles      Dump all roles - only for superuser - don't use for normal user

Supported options:
  -x               Bash debug output of the script - can be used with any other parameter
  -d               Script debug output of logs - can be used with any other parameter
  -v               Script verbose output of logs - can be used with any other option"
}
# _Usage

# _write_config
# write new config file / update from old one
write_config() {

  # default values for variables - updated in case of existing file
  configVersion="$scriptConfigVersion"
  enabled="false"
  postgresqlCommandPrefix=""
  postgresqlDatabase=""
  postgresqlUser="postgres"
  postgresqlPassword=""
  postgresqlPort=""
  postgresqlHost=""
  cpuCount=1

  # if config file exists, create backup and source it to preserve values
  if [ -f "$configFile" ]; then
    cp "$configFile" "${configFile}.back"
    RvLog "Created backup of old config file (${configFile}.back)"
    source "${configFile}.back"

    # replace config version with script version to update config file
    configVersion="$scriptConfigVersion"
  fi

  {
    echo "# config version - checked by the script - for automatic config update"
    echo "configVersion=\"$configVersion\""
    echo "# enable (true) / disable (false) execution of the script"
    echo "enabled=\"$enabled\""
    echo "# how many backups to keep"
    echo "backupLimit=$backupLimit"
    echo "# prefix for commands - keep space at the end of command"
    echo "# sudo -u postgres | docker exec DOCKER_CONTAINER "
    echo "# for docker exec you have to map /var/backup in container to local dir "
    echo "postgresqlCommandPrefix=\"$postgresqlCommandPrefix\""
    echo "# database name to process backup - user must have privileges to dump it"
    echo "postgresqlDatabase=\"$postgresqlDatabase\""
    echo "# user to process backup - idealy superuser - postgres or any other"
    echo "postgresqlUser=\"$postgresqlUser\""
    echo "# password to access postgresql - can be omited using sudo -u postgres prefix of .pgpass file"
    echo "postgresqlPassword=\"$postgresqlPassword\""
    echo "# port for database connection - default is 5432"
    echo "postgresqlPort=$postgresqlPort"
    echo "# hostname / IP for database connection - default is empty - localhost | 192.168.1.2"
    echo "postgresqlHost=\"$postgresqlHost\""
    echo "# number of cpus for pg_dump - default 1"
    echo "cpuCount=\"$cpuCount\""
  } >"$configFile"
  LogError "Config file $configFile written on ($HOSTNAME)"
}
# _write_config
# Define_functions

# Process_parameters
while [ "$#" -gt 0 ]; do
  # PARAMETERS
  # print version and exit
  if [ "$1" = "-V" ] || [ "$1" = "--version" ]; then
    echo "$VERSION"
    exit 0
    # print help and exit
  elif [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    Usage
    exit 0
    # instance name
  elif [ "$1" = "-i" ]; then
    # load config file parameter
    shift

    # replace blanks with underscores in instance name
    instanceName="${1// /_}"

    # overwrite config file
    configFile="$configDir/$scriptName-$instanceName.conf"

    # overwrite backup dir path
    backupDir="$backupDir-$instanceName"

    LogWarning "Processing instance $instanceName"
    LogWarning "Defined alternative config file $configFile"
  elif [ "$1" = "--dump-roles" ]; then
    LogWarning "Detected parameter $1 for dumping all roles"
    dumpRoles="true"
  # OPTIONS
  elif [ "$1" = "-x" ]; then
    LogWarning "Detected parameter $1 for bash debug output of the script"
    set -x
  elif [ "$1" = "-d" ]; then
    LogWarning "Detected parameter $1 for debug output of log messages"
    DEBUG_OUTPUT="true"
  elif [ "$1" = "-v" ]; then
    LogWarning "Detected parameter $1 for verbose output of log messages"
    verbose=1
  else
    LogError "Unknown parameter detected: $1"
    Usage
    exit 1
  fi

  shift
done
# Process_parameters

LogInfo "script ($scriptName) - start"
echo "$$" >"$startFile"
LogInfo "($startFile) set to ($$)"

# write_cron_file
if [ ! -e "$cronFile" ]; then
  # create new cron file
  {
    echo "# execute $scriptName daily - default instance"
    echo "0 1 * * * root $sbinDir/$scriptName > $outputFile"
  } >"$cronFile"
  RvLog "Created new cron file $cronFile for $scriptName"
else
  sed -i -e 's/\&>/> /g' "$cronFile"

  # for non-default instance - create new line in cron file if not present
  if [ -n "$instanceName" ] &&
    [ $(grep -Ec "$scriptName.*$instanceName" "$cronFile") -eq 0 ]; then
    # add line for this instance
    {
      echo "0 2 * * * root $sbinDir/$scriptName -i $instanceName > $outputFile"
    } >>"$cronFile"
    RvLog "Added instance $instanceName to cron file $cronFile for $scriptName"
  fi
fi
# write_cron_file

# load_config_file
# load variables from config file
if [ -f "$configFile" ]; then
  source "$configFile"
  LogInfo "Successfully loaded config file ($configFile)"

  # check script and config version
  if [ "$scriptConfigVersion" != "$configVersion" ]; then
    LogError "Config version ($configVersion) and script version ($scriptConfigVersion) missmatch"
    write_config
    StopProcessing
    exit 2
  fi
else
  write_config
  source "$configFile"
fi
# load_config_file

# check config - stop on disabled execution
if [ "$enabled" = "false" ]; then
  LogInfo "Script ($scriptName) is disabled in config file ($configFile)"
  StopProcessing
  exit 1
fi

# process_variables
#kontrola nastaveni promennych
if [ -z "$backupLimit" ] || [ -z "$postgresqlUser" ] ||
  [ -z "$postgresqlDatabase" ] || [ -z "$backupDir" ]; then
  LogError "Empty one of the key variables backupLimit=($backupLimit),\n\
    postgresqlUser=($postgresqlUser), postgresqlDatabase=($postgresqlDatabase),\n\
    backupDir=($backupDir)"
  StopProcessing
  exit 2
elif [ -n "$postgresqlPassword" ]; then
  export PGPASSWORD="$postgresqlPassword"
fi

# if port is set in configuration, pass it to variable
if [ -n "$postgresqlPort" ]; then
  LogInfo "Postgresql port set to $postgresqlPort"
  postgresqlParams_pg_dump="$postgresqlParams_pg_dump -p $postgresqlPort"
  postgresqlParams_pg_dumpall="$postgresqlParams_pg_dumpall -p $postgresqlPort"
fi

# if host is set in configuration, pass it to variable
if [ -n "$postgresqlHost" ]; then
  LogInfo "Postgresql host set to $postgresqlHost"
  postgresqlParams_pg_dump="$postgresqlParams_pg_dump -h $postgresqlHost"
  postgresqlParams_pg_dumpall="$postgresqlParams_pg_dumpall -h $postgresqlHost"
fi

# for sudo -u postgres change group of backupDir
if [[ "$postgresqlCommandPrefix" =~ "sudo -u " ]]; then
  user=$(echo "$postgresqlCommandPrefix" | sed -e 's/sudo -u\ *\(\w\+\)\ */\1/g')
  chown -R "$user:$user" "$backupDir"
  find "$backupDir" -type d -exec chmod g+s {} \;
  LogInfo "Changing group ownership of $backupDir structure"
fi
# process_variables

# if count of cpus is set in configuration, pass it to variable
# it has to be after psql command because it doesn't support --jobs parameter
if [ -n "$cpuCount" ]; then
  LogInfo "Postgresql cpu count for pg_dump is set to $cpuCount"
  postgresqlParams_pg_dump="$postgresqlParams_pg_dump --jobs=$cpuCount"
fi

# dump_database
backupPath="$backupDir/$postgresqlDatabase/$todayDate"
CheckDir "$backupPath"

# bezne zalohovani bez vynechavani - vcetne pripadne databaze zabbixu
${postgresqlCommandPrefix}pg_dump -U"$postgresqlUser" ${postgresqlParams_pg_dump} \
  -w --dbname="$postgresqlDatabase" --format=directory --no-owner --file="$backupPath/$todayTime"

# nacte navratovou hodnotu - funkce RvLog ji vraci
rv="$?"

if [ "$rv" -eq 0 ] && cd "$backupDir/$postgresqlDatabase"; then
  RvLog "Created dump of postgresql database ($backupPath/$todayTime)"

  # check number of backups - to prevent deleting old backups in case of problems
  if [ "$(find "$backupDir/$postgresqlDatabase" -maxdepth 1 -mindepth 1 -type d | wc -l)" -gt "$backupLimit" ]; then
    # remove old backups - keep $backupLimit only
    find "$backupDir/$postgresqlDatabase" -maxdepth 1 -mindepth 1 -type d -mtime +"$backupLimit" \
      -exec rm -rf {} \;
    RvLog "Old backups removed from ($backupDir/$postgresqlDatabase)"
  fi
else
  LogError "Problem creating postgresql backup ($backupPath/$todayTime)"
fi
# dump_database

# dump_all_roles
# dumps all roles into postgres folder
if [ "$dumpRoles" = "true" ]; then
  backupPath="$backupDir/roles/"
  CheckDir "$backupPath"

  ${postgresqlCommandPrefix}pg_dumpall -U"$postgresqlUser" ${postgresqlParams_pg_dumpall} \
    -w --globals-only --file="$backupPath/roles-$todayDate.sql"
  RvLog "Created dump of postgresql database ($backupPath/roles-$todayDate.sql)"

  # check number of backups - to prevent deleting old backups in case of problems
  if [ "$(find "$backupPath" -maxdepth 1 -mindepth 1 -type f | wc -l)" -gt "$backupLimit" ]; then
    # remove old backups - keep $backupLimit only
    find "$backupPath" -maxdepth 1 -mindepth 1 -type f -mtime +"$backupLimit" \
      -exec rm -f {} \;
    RvLog "Old backups removed from ($backupPath)"
  fi
else
  LogInfo "Dumping all roles is disabled"
fi
# dump_all_roles

unset PGPASSWORD

StopProcessing
exit 0
