#!/bin/bash
#rsync-synchronization - performs synchronization of folder contents using rsync.

# set pipes to fail after first error, preserving last return value of failed process
set -eo pipefail

# set all parameters passed during execution of the script as single parameters
set -- "$@"

VERSION_MAJOR=1
VERSION_MINOR=0
VERSION_PATCH=9
VERSION="$VERSION_MAJOR.$VERSION_MINOR.$VERSION_PATCH"

# Declare_variables
# functions_Usage
# functions_write_config
# process_parameters
# write_cron_file
# load_config_file

# declare_variables
scriptName="rsync-synchronization"

scriptDir="/usr/local/bash-scripts"

scriptConfigVersion="1.2"

verbose=0
# declare_variables

#_LOGGING

#load definition of functions Log,LogError,RvLog,StopProcessing from library
# Load_functions
# load definition of functions LogInfo, LogWarning, LogError,
# RvLog, StopProcessing from library
source "${scriptDir}/funkce"

# Define_functions
# functions_Usage
# print usage of script
Usage() {
  echo -e "Usage: $scriptName [-h] [-V] [-x] [-d] [-v]
  -h, --help      print this help and exit
  -V, --version   print version and exit
  -x              enable bash debug output
  -d              enable debug output of log messages
  -v              enable verbose output of log messages
  
  Script for synchronization of files and directories using rsync.
  It synchronizes each directory from the list with the backup directory."
}
# functions_Usage

# functions_write_config
# write new config file / update from old one
write_config() {
  configVersion="${scriptConfigVersion}"
  enabled="false"
  listOfFolders=()
  localMountPoint="/mnt/${scriptName}"
  mountProtocol="nfs"
  nfsMountShare=""
  smbOMountParams="-o username=USERNAME,password=PASSWORD,rw,iocharset=utf8,mapchars,file_mode=0775,dir_mode=0775"
  smbTargetShare="//192.168.1.100/share/server-name"

  if [ -f "$configFile" ]
  then
    cp "$configFile" "${configFile}.back"
    RvLog "Backup of configuration performed to (${configFile}.back)"
    source "${configFile}.back"

    # replace config version with script version to update config file
    configVersion="${scriptConfigVersion}"
  fi

  {
    echo "# config version - checked by the script - for automatic config update"
    echo "configVersion=\"${configVersion}\""
    echo "# enable (true) / disable (false) execution of the script"
    echo "enabled=\"${enabled}\""
    echo "# list of folders and files for synchronization separated by space"
    echo "# at the beginning must be always / and never at the end"
    echo "listOfFolders=(${listOfFolders[@]})"
    echo "# local mount point - folder where target disk is mounted - without / at the end"
    echo "localMountPoint=\"$localMountPoint\""
    echo "# mount protocol - nfs / smb"
    echo "mountProtocol=\"$mountProtocol\""
    echo "# nfs mount share - hostname or IP address and name of share - without / at the end"
    echo "# example: nfsMountShare=\"192.168.111.1:/home/backup\""
    echo "nfsMountShare=\"$nfsMountShare\""
    echo "# mount command for smb share - login informations can be stored in file"
    echo "# https://serverfault.com/questions/367934/how-do-i-pass-credential-file-to-mount-cifs"
    echo "# https://askubuntu.com/questions/657512/how-to-permanently-mount-password-protected-samba-share-with-workgroup"
    echo "# -o username=USERNAME,password=PASSWORD,rw,iocharset=utf8,mapchars,file_mode=0775,dir_mode=0775,vers=1.0"
    echo "# vers=1.0 is needed if rsync reports rename problems for nested files and nothing remains in target directory"
    echo "smbOMountParams=\"$smbOMountParams\""
    echo "# smb target share - //server/share - without / at the end"
    echo "smbTargetShare=\"$smbTargetShare\""
  } >"$configFile"

  chmod 600 "$configFile"
  LogError "Configuration file for server ($HOSTNAME) written"
}
# functions_write_config

# process_parameters
while [ "$#" -gt 0 ]; do
  # PARAMETERS
  # print version and exit
  if [ "$1" = "-V" ] || [ "$1" = "--version" ]
  then
    echo "$VERSION"
    exit 0
    # print help and exit
  elif [ "$1" = "-h" ] || [ "$1" = "--help" ]
  then
    Usage
    exit 0
  # OPTIONS
  elif [ "$1" = "-x" ]
  then
    echo "Detected parameter $1 for bash debug output of the script"
    set -x
  elif [ "$1" = "-d" ]
  then
    LogWarning "Detected parameter $1 for debug output of log messages"
    DEBUG_OUTPUT="true"
  elif [ "$1" = "-v" ]
  then
    LogWarning "Detected parameter $1 for verbose output of log messages"
    verbose=1
  else
    LogError "Unknown parameter detected: $1"
    Usage
    exit 1
  fi

  shift
done
# process_parameters

LogInfo "script (${scriptName}) - start"
echo "$$" >"${startFile}"
LogInfo "(${startFile}) set to ($$)"

# write_cron_file
if [ ! -e "${cronFile}" ]
then
  # create new cron file
  {
    echo "# execute ${scriptName} daily - default instance"
    echo "0 2 * * * root ${sbinDir}/${scriptName} > ${outputFile}"
  } >"${cronFile}"
  RvLog "Created new cron file ${cronFile} for ${scriptName}"
else
  echo "Cron file exists"
  sed -i -e 's/\&>/> /g' "${cronFile}"
fi
# write_cron_file

# load_config_file
# load variables from config file
if [ -f "${configFile}" ]
then
  source "${configFile}"
  LogInfo "Successfully loaded config file (${configFile})"

  # check script and config version
  if [ "${scriptConfigVersion}" != "${configVersion}" ]
  then
    LogError "Config version (${configVersion}) and script version (${scriptConfigVersion}) mismatch"
    write_config
    StopProcessing
    exit 2
  fi
else
  write_config
  source "${configFile}"
fi
# load_config_file

# check config - stop on disabled execution
if [ "${enabled}" = "false" ]
then
  LogInfo "Script (${scriptName}) is disabled in config file (${configFile})"
  StopProcessing
  exit 1
fi

# process_variables
if [ -z "${listOfFolders}" ]
then
  LogError "List of folders for synchronization is empty"
  StopProcessing
  exit 2
fi

if [ "${mountProtocol}" == "nfs" ]
then
  # --delete, --backup-dir can't be set this way and must be on the command line
  rsyncOptions="-rltDv"

  if [ -z "${localMountPoint}" ]
  then
    LogError "Local mount point is not set"
    StopProcessing
    exit 3
  elif [ -z "${nfsMountShare}" ]
  then
    LogError "NFS mount share is not set"
    StopProcessing
    exit 3
  else
    LogInfo "Synchronization will use NFS protocol and mount ${nfsMountShare} to ${localMountPoint}"
  fi
elif [ "${mountProtocol}" == "smb" ]
then
  # --delete, --backup-dir can't be set this way and must be on the command line
  # without symlinks, which are not supported by SMB
  rsyncOptions="-rLtv"

  if [ -z "${localMountPoint}" ]
  then
    LogError "Local mount point is not set for smb protocol"
    StopProcessing
    exit 4
  elif [ -z "${smbTargetShare}" ]
  then
    LogError "SMB target share is not set"
    StopProcessing
    exit 4
  elif [ -z "${smbOMountParams}" ]
  then
    LogError "SMB mount options are not set for smb protocol"
    StopProcessing
    exit 4
  elif [[ "${smbOMountParams}" =~ "username=USERNAME" ]]
  then
    LogError "SMB mount options contain default username - please update the config file"
    StopProcessing
    exit 4
  elif [[ "${smbOMountParams}" =~ "password=PASSWORD" ]]
  then
    LogError "SMB mount options contain default password - please update the config file"
    StopProcessing
    exit 4
  elif [[ "${smbOMountParams}" =~ "^-o " ]]
  then
    LogError "SMB mount options must start with -o followed by space"
    StopProcessing
    exit 4
  elif [ $(echo "${smbOMountParams}" | grep -c "username=") -eq 0 ] || \
       [ $(echo "${smbOMountParams}" | grep -c "password=") -eq 0 ] && \
       [ $(echo "${smbOMountParams}" | grep -c "credentials=") -eq 0 ]
  then
    LogError "SMB mount options must contain username and password or credentials file"
    StopProcessing
    exit 4
  else
    LogInfo "Synchronization will use SMB protocol and mount to ${localMountPoint}"
  fi
else
  LogError "Mount protocol (${mountProtocol}) is not supported - only nfs and smb are allowed"
  StopProcessing
  exit 2
fi
# process_variables

CheckDir "${localMountPoint}"

# unmount the share if it is still mounted
if [ "$(mount | grep -c $localMountPoint)" -ne 0 ]
then
  LogError "($localMountPoint) is still mounted"
  umount -l -f "$localMountPoint"
  RvLog "Unmounted ($localMountPoint)"
fi

# mount the share
if [ "${mountProtocol}" == "nfs" ]
then
  LogInfo "Mounting ($nfsMountShare) to ($localMountPoint)"
  mount -t nfs "$nfsMountShare" "$localMountPoint"
  RvLog "Mounted partition ($nfsMountShare) to ($localMountPoint)"

  if [ "$?" -ne 0 ]
  then
    LogError "Failed to mount partition ($nfsMountShare) to ($localMountPoint), exiting"
    StopProcessing
    exit 5
  else
    LogInfo "Successfully mounted ($nfsMountShare) to ($localMountPoint)"
  fi
elif [ "${mountProtocol}" == "smb" ]
then
  LogInfo "Mounting SMB share to ($localMountPoint) with options"
  mount -t cifs "${smbTargetShare}" "$localMountPoint" ${smbOMountParams}
  RvLog "Mounted SMB share to ($localMountPoint)"

  if [ "$?" -ne 0 ]
  then
    LogError "Failed to mount SMB share to ($localMountPoint), exiting"
    StopProcessing
    exit 6
  else
    LogInfo "Successfully mounted SMB share to ($localMountPoint)"
  fi
else
  LogError "Mount protocol (${mountProtocol}) is not supported - only nfs and smb are allowed"
  StopProcessing
  exit 2
fi

# start synchronization
for syncFolder in "${listOfFolders[@]}"; do
  baseSyncFolder="$(basename "${syncFolder}")"
  targetSyncFolder="${localMountPoint}/${baseSyncFolder}"
  CheckDir "${targetSyncFolder}"

  LogInfo "Synchronizing folder ${syncFolder} with backup folder ${targetSyncFolder}"

  LogInfo "rsync - starting backup ($syncFolder) to ($targetSyncFolder)"
  if [ "$verbose" -eq 1 ]
  then
    if ! rsync -e "ssh -o StrictHostKeyChecking=no -oUserKnownHostsFile=/dev/null" "$rsyncOptions" \
      --delete --bwlimit=32000 "$syncFolder" "$targetSyncFolder"
    then
      LogError "rsync - ($syncFolder) to ($targetSyncFolder) ended with error"
    else
      LogInfo "rsync - ($syncFolder) to ($targetSyncFolder) completed"
    fi
  else
    if ! rsync -e "ssh -o StrictHostKeyChecking=no -oUserKnownHostsFile=/dev/null" "$rsyncOptions" \
      --delete --bwlimit=32000 "$syncFolder" "$targetSyncFolder" >/dev/null
    then
      LogError "rsync - ($syncFolder) to ($targetSyncFolder) ended with error"
    else
      LogInfo "rsync - ($syncFolder) to ($targetSyncFolder) completed"
    fi
  fi
done

#write changes to disks
sync
RvLog "sync disks"

LogInfo "Unmounting share ($localMountPoint)"
umount -l -f "$localMountPoint"
RvLog "umount ($localMountPoint)"

StopProcessing
LogInfo "OK - ($scriptName) backup completed"
exit 0
